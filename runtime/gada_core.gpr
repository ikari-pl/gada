--  GADA core runtime library project.
--
--  Owns the top-level umbrella package `Gada` and the `Gada.Core` child
--  package. Later phases add `Gada.Core.IO`, `Gada.Async`, etc., as either
--  child units of this library or sibling library projects (see AGENTS.md
--  §"The runtime is layered").

library project Gada_Core is

   --  Build mode scenario variable.
   --
   --  "normal"   — default, vanilla compile.
   --  "coverage" — adds -fprofile-arcs -ftest-coverage to the compile and
   --               -lgcov to the link. Set by tools/coverage_ada.sh when
   --               producing the lcov tracefile. Coverage builds are
   --               additionally placed in a `cov/` sub-object-dir
   --               (`gprbuild --subdirs=cov`) so they coexist with normal
   --               builds without forcing an `-f` full rebuild.
   --
   --  Importing projects (e.g. tests/aunit_harness.gpr) re-declare this
   --  variable with the same name and forward it; that way `gprbuild
   --  -XBuild_Mode=coverage` propagates uniformly across the closure of
   --  GADA-owned projects WITHOUT touching Alire-supplied dependency
   --  projects (AUnit, etc.) whose own caches must stay pristine.
   type Build_Mode_Type is ("normal", "coverage");
   Build_Mode : Build_Mode_Type := external ("Build_Mode", "normal");

   --  Target architecture, used to pick the right libco
   --  implementation under src/vendor/libco/. v1's contracted
   --  matrix (ADR-0007 §4) is amd64 + aarch64 hosted; the runtime
   --  Makefile derives this from `uname -m` (x86_64 -> amd64,
   --  arm64/aarch64 -> aarch64) and exports ARCH so this `external`
   --  call picks it up. The default ("amd64") is the most common
   --  CI target so a fresh gprbuild without the env var still
   --  builds something sensible — the Makefile is the
   --  authoritative selector.
   type Arch_Type is ("amd64", "aarch64");
   Arch : Arch_Type := external ("ARCH", "amd64");

   for Library_Name use "gada_core";
   for Library_Kind use "static";

   for Source_Dirs use ("src", "src/vendor/libco");
   for Object_Dir  use "obj";
   for Library_Dir use "lib";

   for Languages use ("Ada", "C");

   --  Per-architecture source selection (ADR-0007 §5).
   --
   --  We deliberately compile *only* the per-arch implementation
   --  file (amd64.c or aarch64.c), never libco.c. libco.c is
   --  upstream's dispatcher: it `#include`s the arch source via
   --  an `#if defined(__amd64__)` cascade, which would produce a
   --  second translation unit defining the same `co_*` symbols
   --  the per-arch file already defines and break the link with
   --  duplicate-symbol errors. The build system is the right
   --  layer to know the target arch, so we route the selection
   --  through the gpr scenario variable rather than the C
   --  preprocessor.
   --
   --  libco.c stays in the vendored source set (so a `vendor:
   --  bump libco` commit doesn't have to remember per-file
   --  deviations from upstream) but is excluded from compilation
   --  on every supported arch.
   case Arch is
      when "amd64" =>
         for Excluded_Source_Files use ("libco.c", "aarch64.c");
      when "aarch64" =>
         for Excluded_Source_Files use ("libco.c", "amd64.c");
   end case;

   package Compiler is
      Common_Switches := ("-gnat2022",   --  Ada 2022 by default; we want the latest standard.
                          "-gnatwa",     --  All optional warnings on.
                          "-gnatyy",     --  Default style checks (Gada style guide refines later).
                          "-O0",
                          "-g");
      case Build_Mode is
         when "normal" =>
            for Default_Switches ("Ada") use Common_Switches;
         when "coverage" =>
            for Default_Switches ("Ada") use
              Common_Switches & ("-fprofile-arcs", "-ftest-coverage");
      end case;

      --  C compile switches for the vendored libco.
      --
      --  -O2 + -g: libco's per-arch file is hand-written assembly
      --     wrapped in C; -O0 produces noticeably worse code for the
      --     C scaffolding (allocation, stack management). The Ada
      --     side stays at -O0 because the runtime is still under
      --     active development and -O0 keeps stack traces readable;
      --     libco's C is stable upstream so a higher opt level here
      --     does not hurt debuggability of GADA's own code.
      --  -Wno-parentheses: libco uses bit-and inside an equality
      --     comparison without parens; upstream is C89-pedantic so
      --     we honour that style rather than patch the vendored
      --     source.
      --  -DLIBCO_MP: load-bearing for multi-worker (Phase 3 sub-item
      --     3b). Without it, libco's settings.h:14 expands
      --     `thread_local` to nothing (the "single-threaded" branch),
      --     so `co_active_handle` and `co_active_buffer` compile to
      --     plain process-global variables shared across all OS
      --     threads. Two workers concurrently calling co_switch then
      --     trash each other's saved register state — the entire
      --     "cothreads cannot migrate" invariant collapses, and the
      --     downstream symptom is the missing-Exits-key CE in
      --     Gada.Async.Context.Trampoline. Single-worker builds
      --     happen to work because there's only one thread to share
      --     the globals, but flipping Workers > 1 immediately races.
      --     Documented at the libco README's "thread-local storage"
      --     section: "Define LIBCO_MP at compile time to enable real
      --     thread-local handles." The full investigation is in
      --     docs/incidents/2026-05-03-scheduler-3b-multi-worker-race
      --     (the second-pass diagnosis under "TLS replacement found
      --     the C-side LIBCO_MP issue").
      --  Coverage switches do not propagate to C — gcov works on
      --     C too, but the gada_core coverage gate scopes only
      --     runtime/src/*.{adb,ads} (tools/coverage_thresholds.toml),
      --     so libco's lines do not enter the denominator. Keeping
      --     the C side opt'd-in to coverage instrumentation would
      --     just add noise.
      --  -Dthread_local=__thread overrides settings.h's lookup logic.
      --     Settings.h's C11 branch does `#include <threads.h>`, which
      --     doesn't exist on macOS (Apple's libc never shipped the C11
      --     threads header). The settings.h comment block at line 13
      --     explicitly invites this override: "User can override
      --     thread_local for obscure compilers". `__thread` is the
      --     GCC/Clang extension, supported on every libco-contracted
      --     v1 platform (amd64 + aarch64, Linux + macOS) per ADR-0007.
      C_Switches := ("-O2", "-g", "-Wall", "-Wno-parentheses",
                     "-DLIBCO_MP",
                     "-Dthread_local=__thread");
      for Default_Switches ("C") use C_Switches;
   end Compiler;

   --  No `package Linker` here.
   --
   --  gada_core is `Library_Kind = "static"` — gprbuild emits
   --  `libgada_core.a` and the linker switches a static library
   --  declares are *not* taken into account (gprbuild emits the
   --  warning "Linker switches not taken into account in library
   --  projects" if you try). The libgc switches needed at executable
   --  link time live in `tests/aunit_harness.gpr` (and any future
   --  executable project that links gada_core); the same applies to
   --  `-lgcov` under Build_Mode=coverage. See ADR-0005 for the
   --  resolution mechanism (pkg-config bdw-gc + external_as_list).

end Gada_Core;
